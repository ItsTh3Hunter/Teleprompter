<Window x:Class="Teleprompter.JanelaTeleprompter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teleprompter"
        WindowStyle="None"
        WindowState="Maximized"
        Background="Black"
        KeyDown="Passador_Slide">

    <Canvas x:Name="canvas">
        <TextBlock x:Name="txtTeleprompter"
                   FontSize="56"
                   Foreground="White"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Canvas.Left="50"
                   LineHeight="80"/>
    </Canvas>
</Window>