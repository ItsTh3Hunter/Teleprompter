<Window x:Class="Teleprompter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Teleprompter"
        mc:Ignorable="d"
        Title="Teleprompter - Configuração" 
        Height="600" Width="800" 
        ResizeMode="CanMinimize" 
        Background="#1e1e1e">
    <!-- ResizeMode="CanMinimize" Impede que o usuário maximize a janela evitando problemas de layout-->
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <WrapPanel Grid.Row="0" Margin="0,0,16,0">
            
            <StackPanel Margin="0,0,20,0">
                
                <Label Content="Fonte" 
                       FontSize="16" 
                       Foreground="#aaaaaa" 
                       Margin="0,0,0,4"
                       HorizontalContentAlignment="Center"/>
                
                <ComboBox x:Name="cmbFonte" 
                          Width="160" 
                          Height="32"
                          FontSize="18"
                          HorizontalContentAlignment="Center">
                    <ComboBoxItem Content="Arial" IsSelected="True"/>
                    <ComboBoxItem Content="Calibri"/>
                    <ComboBoxItem Content="Times New Roman"/>
                    <ComboBoxItem Content="Verdana"/>
                    <ComboBoxItem Content="Courier New"/>
                    <ComboBoxItem Content="Georgia"/>
                </ComboBox>
            </StackPanel>
            
            <StackPanel>
                <Label Content="Tamanho da Fonte" 
                       FontSize="16" 
                       Foreground="#aaaaaa" 
                       Margin="0,0,0,4"/>
                
                <ComboBox x:Name="cmbTamanhoFonte" 
                          Width="100" 
                          Height="32"
                          FontSize="18"
                          HorizontalContentAlignment="Center">
                    <ComboBoxItem Content="12"/>
                    <ComboBoxItem Content="14"/>
                    <ComboBoxItem Content="16"/>
                    <ComboBoxItem Content="18"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="24"/>
                    <ComboBoxItem Content="28"/>
                    <ComboBoxItem Content="32"/>
                    <ComboBoxItem Content="36"/>
                    <ComboBoxItem Content="40"/>
                    <ComboBoxItem Content="47"/>
                    <ComboBoxItem Content="56" IsSelected="True"/>
                    <ComboBoxItem Content="64"/>
                    <ComboBoxItem Content="72"/>
                    <ComboBoxItem Content="80"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,0,20,0">
                
                <Label Content="Velocidade" 
                       Foreground="#aaaaaa" 
                       FontSize="16" 
                       Margin="0,0,0,4"
                       HorizontalContentAlignment="Center"/>
                
                <StackPanel Orientation="Horizontal">
                    
                    <Slider x:Name="sldVelocidade" 
                            Minimum="1" Maximum="10"
                            Value="3" Width="160" 
                            VerticalAlignment="Center"/>

                    <Label   x:Name="txtVelocidade" 
                             Content="{Binding ElementName=sldVelocidade, Path=Value}"
                             ContentStringFormat="{}{0:N0}"
                             Foreground="#aaaaaa" 
                             Margin="8,0,0,0" 
                             VerticalAlignment="Center"
                             FontSize="16"
                             Width="30"/>
                </StackPanel>
            </StackPanel>
        </WrapPanel>
        
        <WrapPanel Grid.Row="1" Margin="0,0,0,0">
            <StackPanel Margin="0,20,20,0">
                <TextBlock Text="Cor do Texto" 
                           FontSize="16" Foreground="#aaaaaa" 
                           Margin="0,0,0,4"/>
                <Button x:Name="btnCorTexto" 
                        Width="60" 
                        Height="32" 
                        Background="White" 
                        BorderBrush="#555555" 
                        BorderThickness="1"
                        Click="btnCorTexto_Click"/>
            </StackPanel>
            <StackPanel Margin="0,20,20,0">
                <TextBlock Text="Cor de Fundo" 
                           FontSize="16" 
                           Foreground="#aaaaaa" 
                           Margin="0,0,0,4"/>
                <Button x:Name="btnCorFundo" 
                        Width="60" 
                        Height="32" 
                        Background="Black" 
                        BorderBrush="#555555" 
                        BorderThickness="1" 
                        Click="btnCorFundo_Click"/>
            </StackPanel>
        </WrapPanel>
        
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            
            <Label   Content="Cole seu texto aqui" 
                       FontSize="16" 
                       Foreground="#aaaaaa" 
                       Margin="0,0,0,4"
                       HorizontalContentAlignment="Center"/>

            <TextBox x:Name="txtRoteiro" 
                     AcceptsReturn="True" 
                     VerticalScrollBarVisibility="Auto" 
                     Height="250"
                     FontSize="14"
                     Padding="10"
                     TextWrapping="Wrap"
                     Background="#2d2d2d" 
                     Foreground="#ffffff" 
                     BorderBrush="#555555" 
                     CaretBrush="#ffffff"/>
        </StackPanel>

        <Button Grid.Row="3" Content="Iniciar Teleprompter" 
                Width="180" Height="40" 
                HorizontalAlignment="Right"
                FontSize="16"
                Background="#0066cc" 
                Foreground="White" 
                BorderBrush="#555555" 
                BorderThickness="0" 
                Click="btnIniciar_Click"/>
    </Grid>
</Window>
